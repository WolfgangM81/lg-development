# Development Environment Configuration
#
# This file contains environment variables for local development.
# Copy to .env.dev and customize for your setup.
#
# Usage:
#   cp .env.dev.example .env.dev
#   docker-compose --env-file .env.dev up -d

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# General Development Settings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Node environment (use 'development' for hot-reload)
NODE_ENV=development

# Enable debug logging
DEBUG=*

# Log level (error, warn, info, debug, trace)
LOG_LEVEL=debug

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Package Hot-Reload Settings (Optional)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# TypeScript compiler watch mode options
# Increase if builds are too frequent (CPU usage high)
TS_WATCH_DELAY_MS=500

# Builder health check interval (seconds)
BUILDER_HEALTH_INTERVAL=5

# Builder health check timeout (seconds)
BUILDER_HEALTH_TIMEOUT=3

# Builder health check retries before marking unhealthy
BUILDER_HEALTH_RETRIES=3

# Enable incremental TypeScript compilation (faster rebuilds)
TS_INCREMENTAL=true

# TypeScript compiler options
# --preserveWatchOutput: Keeps watch output clean
# --pretty: Colored output for errors
TS_COMPILER_FLAGS=--preserveWatchOutput --pretty

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Volume Mount Performance (macOS specific)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Volume mount mode for source code (macOS: 'cached' for better performance)
# Options: default, cached, delegated, consistent
# Linux: Usually use 'default' (native performance)
VOLUME_MOUNT_MODE=cached

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Smart Restart Settings
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable smart service restarts (only affected services)
# Requires jq to be installed
# Set to 'false' to always restart all services
SMART_RESTART_ENABLED=true

# Delay before restarting services after package build (seconds)
# Allows multiple rapid changes to settle before restart
RESTART_DELAY_SECONDS=2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Metrics & Monitoring
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable build performance metrics collection
METRICS_ENABLED=true

# Metrics retention (number of builds to keep)
METRICS_MAX_BUILDS=100

# Dashboard refresh interval (seconds)
DASHBOARD_REFRESH_INTERVAL=2

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Database (inherited from .env, can override for dev)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Uncomment to override production database settings
# DATABASE_URL=postgres://licenseguard:dev_password@postgres:5432/licenseguard_dev
# POSTGRES_USER=licenseguard
# POSTGRES_PASSWORD=dev_password
# POSTGRES_DB=licenseguard_dev

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Frontend HMR Settings (Vite, lg-admin)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Vite HMR port (usually auto-detected)
# VITE_HMR_PORT=3000

# Vite HMR host (for Docker)
# VITE_HMR_HOST=localhost

# Enable Vite HMR overlay (error display in browser)
VITE_HMR_OVERLAY=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Backend Watch Mode (Nodemon, tsx watch)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Nodemon delay before restart (milliseconds)
NODEMON_DELAY=1000

# Watch additional file extensions
NODEMON_WATCH_EXTENSIONS=ts,js,json

# Ignore patterns (comma-separated)
NODEMON_IGNORE=node_modules,dist,coverage,*.test.ts

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Tips & Best Practices
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 1. Enable hot-reload: make dev-sync
# 2. Open dashboard: make dev-sync-dashboard
# 3. Edit packages in repos/lg-*/src/
# 4. Watch compilation in ~2-3s
# 5. Services auto-restart (smart: only affected ones!)
#
# See: HOT_RELOAD_QUICK_REF.md for complete reference
