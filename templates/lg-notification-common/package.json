{
  "name": "@wolfgangm81/lg-notification-common",
  "version": "1.0.0",
  "description": "Shared notification utilities for LicenseGuard services (email, SMS, push)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build"
  },
  "keywords": ["notifications", "email", "sms", "push", "licenseguard"],
  "author": "LicenseGuard Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WolfgangM81/lg-notification-common.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "nodemailer": "^6.9.7",
    "twilio": "^4.20.0",
    "firebase-admin": "^12.0.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/handlebars": "^4.1.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
