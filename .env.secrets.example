# GitHub Secrets Configuration
# Copy this file to .env.secrets and fill in your actual values
# NEVER commit .env.secrets to git!

# GitHub Personal Access Token (classic)
# Scopes needed: repo, write:packages, read:packages
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NPM Token for GitHub Packages
# Same as GITHUB_TOKEN for GitHub Packages
# Or create separate token at: https://github.com/settings/tokens
NPM_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Docker Registry Password
# For GitHub Container Registry, use same as GITHUB_TOKEN
DOCKER_PASSWORD=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database Connection (for service tests)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://admin:your_postgres_password@localhost:5432/licenseguard

# JWT Secret (for authentication)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# PostgreSQL Password (for Docker deployments)
POSTGRES_PASSWORD=your_postgres_password

# Redis Password (for Docker deployments)
REDIS_PASSWORD=your_redis_password

# Frontend API URL (for Next.js builds)
NEXT_PUBLIC_API_URL=https://api.example.com
